# ──────────────────────────────────────────────────────────────────────────────
# LinkedIn Agent – Backend Environment Variables
# Copy this file to backend/.env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────────────────────────
# Required: your bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Required: your personal chat ID (send /start to the bot and check the logs)
TELEGRAM_CHAT_ID=your-chat-id-here

# Optional: HTTP/SOCKS5 proxy for regions where Telegram is blocked (e.g. Pakistan).
# Formats:
#   HTTPS proxy:  https://user:pass@proxyhost:port
#   SOCKS5 proxy: socks5://user:pass@proxyhost:port
# Leave empty if Telegram is accessible directly.
TELEGRAM_PROXY=

# ── LLM (LongCat / OpenAI-compatible API) ────────────────────────────────────
# Required: API key for the LLM service
LONGCAT_API_KEY=your-llm-api-key-here
# Alternative: if you use a plain OpenAI key instead
# OPENAI_API_KEY=sk-...

# Optional: model name (default: longcat-flash-lite)
LLM_MODEL=longcat-flash-lite

# Optional: base URL for the OpenAI-compatible endpoint
LONGCAT_BASE_URL=https://api.longcat.chat/openai

# Optional: request timeout in seconds (default: 60)
LLM_TIMEOUT_SECONDS=60

# ── GitHub ────────────────────────────────────────────────────────────────────
# Your GitHub username – used to fetch repos and activity
GITHUB_USERNAME=H0NEYP0T-466

# ── Storage ───────────────────────────────────────────────────────────────────
# Directory for all agent data (repos, posts, state, etc.)
DATA_DIR=./data

# Directory where repos are cloned (default: DATA_DIR/repos)
REPOS_DIR=./data/repos

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8006

# ── Cloudflare Browser Rendering (optional, for JS-heavy scraping) ─────────
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
