# LinkedIn Agent - Environment Variables
# Copy this file to .env and fill in your values

# Google Gemini API key (for LongCat-Flash-Lite / gemini-2.0-flash-lite)
GOOGLE_API_KEY=your_google_api_key_here

# Telegram bot token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram chat ID (run the bot and send /start to get your chat ID)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# GitHub username
GITHUB_USERNAME=H0NEYP0T-466

# Cloudflare Browser Rendering API (optional, for JS-heavy pages)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# LLM model name (default: gemini-2.0-flash-lite)
LLM_MODEL=gemini-2.0-flash-lite

# Data directory (default: ./data)
DATA_DIR=./data

# Repos clone directory (default: ./data/repos)
REPOS_DIR=./data/repos
